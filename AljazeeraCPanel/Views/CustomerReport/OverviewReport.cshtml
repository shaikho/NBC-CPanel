<script>
  

    $('#example tr').each(function (index, element) {
        if (index != 0) {
            let accAmount = element.lastElementChild;
            let amount = accAmount.innerText.split(' ')[0];
            let parsedAmount = Number.parseFloat(amount).toLocaleString();
            accAmount.textContent = parsedAmount + ' SDG';
        }
    });

    
    $('#example2 tr').each(function (index, element) {
        if (index != 0) {
            let tranAmount = element.lastElementChild;
            let amount = tranAmount.innerText.split(' ')[0];
            let parsedAmount = Number.parseFloat(amount).toLocaleString();
            tranAmount.textContent = parsedAmount + ' SDG';
        }
    });

        $("#filtercardbranch").on("click", function () {
            if ($("#fromdate1").val() == "" || $("#todate1").val() == "") {
                alert("Please select date filter");
            } else {
                $('#overlay').show();
                $.ajax({
                    type: 'GET',
                    cache: false,
                    url: '/CustomerReport/FilteredDateOverviewReport',
                    dataType: 'json',
                    data: {
                        branch_code: $("#dropfilter").val(),
                        fromdate: $("#fromdate1").val(),
                        todate: $("#todate1").val()

                    },
                    contentType: 'application/json',
                    success: function (result) {
                        $("#example").dataTable().fnClearTable();
                        $.each(result, function (status, data) {
                            $.each(data, function (innerstatus, innerdata) {
                                var data = [];
                                data.push(innerdata.TranResult);
                                data.push(innerdata.CurrencyCode);
                                let tranAmount = Number.parseFloat(innerdata.TranReqAmount).toLocaleString();
                                data.push(tranAmount);
                                $("#example").dataTable().fnAddData(data);
                            });
                        });
                        $('#overlay').hide();
                    }
                });
            }
        });


        $("#filtercardtran").on("click", function () {
            if ($("#fromdate2").val() == "" || $("#todate2").val() == "") {
                alert("Please select date filter");
            } else {
                $('#overlay').show();
                $.ajax({
                    type: 'GET',
                    cache: false,
                    url: '/CustomerReport/FilterTransactionsDatePerBranches',
                    dataType: 'json',
                    data: {

                        transaction_name: $("#transactionsperbranch").val(),
                        fromdate: $("#fromdate2").val(),
                        todate: $("#todate2").val()

                    },
                    contentType: 'application/json',
                    success: function (result) {
                        $("#example2").dataTable().fnClearTable();
                        $.each(result, function (status, data) {
                            $.each(data, function (innerstatus, innerdata) {
                                var data = [];
                                data.push(innerdata.TranResult);
                                data.push(innerdata.CurrencyCode);
                                let tranAmount2 = Number.parseFloat(innerdata.TranReqAmount).toLocaleString();                             
                                data.push(tranAmount2);
                                $("#example2").dataTable().fnAddData(data);
                            });
                        });
                        $('#overlay').hide();
                    }
                });
            }
        });
    </script>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}