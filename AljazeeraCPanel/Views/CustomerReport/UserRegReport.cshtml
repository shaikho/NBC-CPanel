<script>
    $(document).ready(function () {
        var table = $('#example').DataTable();
    });</script>
<script>
    $("#filtercard").on("click", function () {
        if ($("#fromdate1").val() == "" || $("#todate1").val() == "") {
            alert("Please select date filter");
        } else {
            $('#overlay').show();
            $.ajax({
                type: 'GET',
                cache: false,
                url: '/CustomerReport/FilterUserRegReport',
                dataType: 'json',
                data: {
                    branch_code: $("#branchfilter1").val(),
                    status: $("#statusfilter1").val(),
                    fromdate: $("#fromdate1").val(),
                    todate: $("#todate1").val()

                },
                contentType: 'application/json',
                success: function (result) {
                    $("#example").dataTable().fnClearTable();
                    $.each(result, function (status, data) {
                        $.each(data, function (innerstatus, innerdata) {
                            var data = [];
                            //data.push(innerdata.TranFromAccount);
                            //data.push(innerdata.PAN);
                            //let tranAmount = Number.parseFloat(innerdata.TranReqAmount).toLocaleString();
                            //data.push(tranAmount);
                            //data.push(innerdata.ResponseStsatus);
                            //data.push(innerdata.RRN);
                            //data.push(innerdata.FT);
                            //data.push(innerdata.TranDate);
                            data.push(innerdata.AxisX);
                            data.push(innerdata.AxisY);
                            $("#example").dataTable().fnAddData(data);
                        });
                    });
                    $('#overlay').hide();
                }
            });
        }
    });</script>