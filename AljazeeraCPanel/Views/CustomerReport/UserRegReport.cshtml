                            No of Accounts
                        </th>

                    </tr>
                </thead>
                <tbody id="tablebody">
                    @if (creditapitransactions != null)
                    {
                        foreach (var counts in creditapitransactions)
                        {
                            <tr>


                                <td style="font-size:small">
                                    @counts.AxisX
                                </td>

                                <td style="font-size:small">
                                    @counts.AxisY
                                </td>

                            </tr>
                            }
                    }
                </tbody>
            </table>
        </div>
                        <br />
