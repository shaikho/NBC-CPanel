@model AljazeeraCPanel.Models.Custreport

@{
    ViewBag.Title = "Get Customer Information";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="col-md-12 connectedSortable">
    <!-- Own Transfer -->
    <div class="box box-info">

        <h2>Registered Customers</h2><br />
        <ol class="breadcrumb" style="font-size:medium">
            Customer informations
        </ol>


        @if (ViewBag.SuccessMessage != null)
        {
            <div class="alert alert-success" role="alert">
                <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <strong>Success!</strong> @ViewBag.SuccessMessage
            </div>
        }

        <div class="box-body">
            <div class="row">
                <div class="col-md-10 ">

                    @using (Html.BeginForm(new { id = "form" }))
                    {
                        @Html.AntiForgeryToken()

                    <div class="form-horizontal">
                        @Html.ValidationSummary(true)

                        <div class="form-group">
                            <label class="control-label col-md-4">Customer Phone number</label>
                            <div class="col-md-6">
                                @Html.TextBoxFor(model => model.phonenumber, new { @class = "form-control ", @placeholder = "...", @maxlength = "13", @onkeypress = "return event.charCode >= 48 && event.charCode <= 57" })
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="control-label col-md-4">Customer RIM</label>
                            <div class="col-md-6">
                                @Html.TextBoxFor(model => model.rim, new { @class = "form-control ", @placeholder = "...", @maxlength = "10", @onkeypress = "return event.charCode >= 48 && event.charCode <= 57" })
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="control-label col-md-4">Customer Account</label>
                            <div class="col-md-6">
                                @Html.TextBoxFor(model => model.AccountNumber, new { @class = "form-control ", @placeholder = "...", @maxlength = "10", @onkeypress = "return event.charCode >= 48 && event.charCode <= 57" })
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="control-label col-md-4">Customer User Id</label>
                            <div class="col-md-6">
                                @Html.TextBoxFor(model => model.username, new { @class = "form-control ", @placeholder = "...", @maxlength = "10", @onkeypress = "return event.charCode >= 48 && event.charCode <= 57" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-xs-2 col-xs-offset-5">
                                <input type="submit" onclick="submitanddisable()" formaction="@Url.Action("getCustomerInformation","CustomerReport")" value="Submit" class="btn btn-md btn-flat btn-block" style="color:white;font-size:small" />
                            </div>
                        </div>

                    </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>


@if (TempData["successful"] != null)
{
    <script>
        Swal.fire({
            icon: 'success',
            title: 'Successful',
            text: '@TempData["successful"].ToString()'
        })
    </script>
}

@if (TempData["failed"] != null)
{
    <script>
        Swal.fire({
            icon: 'error',
            title: 'Failed',
            text: '@TempData["failed"].ToString()'
        })
    </script>
}

@if (ViewBag.SuccessMessage != null)
{
    <script>
        window.setTimeout(function () {
            $(".alert").fadeTo(500, 0).slideUp(500, function () {
                $(this).remove();
            });
        }, 4000);
    </script>
}

<script src="~/Scripts/jquery-3.4.1.js"></script>