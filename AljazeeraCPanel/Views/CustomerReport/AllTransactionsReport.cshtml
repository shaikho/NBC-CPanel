    List<CustomerTransferReportViewModel> creditapitransactions = Session["creditapitransactions"] as List<CustomerTransferReportViewModel>;
    List<CustomerTransferReportViewModel> accounttransfertransactions = Session["accounttranfertransactions"] as List<CustomerTransferReportViewModel>;
}

<header>
    <script src="~/Content/jquery.dataTables.js"></script>
    <link href="~/Content/jquery.dataTables.css" rel="stylesheet" />
    <style>

        body {
            overflow-y: visible
        }

        td {
            font-size: small !important;
        }
    </style>

    <script>
        $(document).ready(function () {
            var table = $('#example').DataTable();
            var table2 = $('#example2').DataTable();
        });
    </script>
</header>

<section class="content">
    <div class="row">
        <div class="col-md-12">
            <div class="box box-info">
                <h2>Transactions Details</h2><br />
                <ol class="breadcrumb" style="font-size:medium">
                    Account to card transactions
                </ol>
                <div class="box-body">
                    @using (Html.BeginForm(new { id = "form" }))
                    {
                        <div class="col-lg-12 col-md-12 col-sm-12">
                            <div class="form-group">
                                <label class="control-label col-md-2" style="margin-top:0.5%">from date</label>
                                <div class="col-md-3">
                                    <input class="form-control" type="date" name="fromdate" id="fromdate1">
                                </div>
                                <label class="control-label col-md-2" style="margin-top:0.5%">to date</label>
                                <div class="col-md-4">
                                    <input class="form-control" type="date" name="todate" id="todate1">
                                </div>
                                <br /><br />
                                <label class="control-label col-md-1" style="margin-top:0.5%">Branch</label>
                                <div class="col-md-4">
                                    @Html.DropDownListFor(model => model.BranchCode, Model.Branches, new { @class = "form-control ", @placeholder = "Branch...", @id = "branchfilter1" })
                                </div>
                                <label class="control-label col-md-2" style="margin-top:0.5%">Transaction status</label>
                                <div class="col-md-4">
                                    @Html.DropDownListFor(model => model.CategoryCode, Model.transactions_statuses, new { @class = "form-control ", @placeholder = "Branch...", @id = "statusfilter1" })
                                </div>
                                <br />
                                <br />
                                <br />
                                <div class="col-md-12 col-md-offset-5">
                                    <input class="btn btn-md" id="filtercard" type="button" style="color:white;font-size:small" value="Filter" />
                                </div>
                                <br /><br />
                            </div>
                            <hr />
                            <table id="example" class="display nowrap" style="font-size:small">
                                <thead>
                                    <tr>
                                        <th style="font-size:small">
                                            From Account
                                        </th>
                                        <th style="font-size:small">
                                            PAN
                                        </th>
                                        <th style="font-size:small">
                                            Amount
                                        </th>
                                        <th style="font-size:small">
                                            Status
                                        </th>
                                        <th style="font-size:small">
                                            RRN
                                        </th>
                                        <th style="font-size:small">
                                            FT
                                        </th>
                                        <th style="font-size:small">
                                            Date
                                        </th>
                                    </tr>
                                </thead>
                                <tbody id="tablebody">
                                    @foreach (var transaction in creditapitransactions)
                                    {
                                        <tr>

                                            <td style="font-size:small">
                                                @transaction.TranFromAccount
                                            </td>
                                            <td style="font-size:small">
                                                @transaction.PAN
                                            </td>
                                            <td style="font-size:small">
                                                @transaction.TranReqAmount
                                            </td>
                                            <td style="font-size:small">
                                                @transaction.ResponseStatus
                                            </td>
                                            <td style="font-size:small">
                                                @transaction.RRN
                                            </td>
                                            <td style="font-size:small">
                                                @transaction.FT
                                            </td>
                                            <td style="font-size:small">
                                                @transaction.TranDate
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <br />
                        <br />
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-57 col-xs-offset-6" style="position:relative;right:9%">
        <input type="submit" onclick="submitanddisable()" formaction="@Url.Action("savecreditapireport", "CustomerReport")" value="Print report" class="btn btn-lg" style="color:white;font-size:small" />
    </div>
    <br />
