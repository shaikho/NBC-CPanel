@if (TempData["authorizedsuccess"] != null)
{
    <script>
        Swal.fire({
            icon: 'success',
            title: 'Successful',
            text: '@TempData["authorizedsuccess"].ToString()'
        })
    </script>
}

@if (TempData["authorizedfail"] != null)
{
    <script>
        Swal.fire({
            icon: 'error',
            title: 'Failed',
            text: '@TempData["authorizedfail"].ToString()'
        })
    </script>
}

@if (ViewBag.SuccessMessage != null)
{
    <script>
        window.setTimeout(function () {
            $(".alert").fadeTo(500, 0).slideUp(500, function () {
                $(this).remove();
            });
        }, 4000);
    </script>
}

@if (TempData["fail"] != null)
{
    <script>
        window.setTimeout(function () {
            $(".alert").fadeTo(500, 0).slideUp(500, function () {
                $(this).remove();
            });
        }, 4000);
    </script>
}