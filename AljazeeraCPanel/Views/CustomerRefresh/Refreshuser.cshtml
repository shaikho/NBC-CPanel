@model AljazeeraCPanel.Models.CustomerRegBankinfo

@{
    ViewBag.Title = "Customer Infomation";
}

<section class="content">

    <div class="box-header with-border">
        <h3 class="box-title my-box-header"></h3>
    </div>
    <h2>Refresh Customer Registration</h2><br />
    <ol class="breadcrumb" style="font-size:medium">
        Customer Regstration Bank Information
    </ol>

    @if (ViewBag.SuccessMessage != null)
    {
        <div class="alert alert-success" role="alert">
            <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            <strong>Success!</strong> @ViewBag.SuccessMessage
        </div>
    }

    <div class="row">
        <div class="col-md-12 col-md-offset-4">
            <!-- TABLE: LATEST Transactions -->
            <div class="box box-info">
                <div class="box-header with-border">
                    <div class="box-tools pull-right">
                        @*<button type="button" class="btn btn-box-tool" data-widget="collapse">
                                <i class="fa fa-minus"></i>
                            </button>*@
                        @*<button type="button" class="btn btn-box-tool" data-widget="remove"><i class="fa fa-times"></i></button>*@
                    </div>
                </div>
                <!-- /.box-header -->
                <div class="box-body">
                    <div class="table-responsive">
                        @*<div class="col-md-6 col-md-offset-0">*@
                        @using (Html.BeginForm())
                        {
                            @Html.AntiForgeryToken()
                            @Html.ValidationSummary(true)
                        <table id="example1" class="display table-bordered table-hover">
                            <tr>
                                <th style="font-size:small">
                                    @Html.DisplayNameFor(model => model.CustomerName)
                                </th>
                                <td style="font-size:small">
                                    @Html.DisplayFor(model => model.CustomerName)
                                </td>
                            </tr>
                            <tr>
                                <th style="font-size:small">
                                    @Html.DisplayNameFor(model => model.customernameArabic)
                                </th>
                                <td style="font-size:small">
                                    @Html.DisplayFor(model => model.customernameArabic)
                                </td>
                            </tr>
                            <tr>
                                <th style="font-size:small">
                                    @Html.DisplayNameFor(model => model.CustomerPhone)
                                </th>
                                <td style="font-size:small">
                                    @Html.DisplayFor(model => model.CustomerPhone)
                                </td>
                            </tr>
                            <tr>
                                <th style="font-size:small">
                                    @Html.DisplayNameFor(model => model.address)
                                </th>
                                <td style="font-size:small">
                                    @Html.DisplayFor(model => model.address)
                                </td>
                            </tr>
                            <tr>
                                <th style="font-size:small">
                                    @Html.DisplayNameFor(model => model.rim)
                                </th>
                                <td style="font-size:small">
                                    @Html.DisplayFor(model => model.rim)
                                </td>
                            </tr>

                            <tr>
                                <th style="font-size:small">
                                    @Html.DisplayNameFor(model => model.iban)
                                </th>
                                <td style="font-size:small">
                                    @Html.DisplayFor(model => model.iban)
                                </td>
                            </tr>

                            <tr>
                                <th style="font-size:small">
                                    @Html.DisplayNameFor(model => model.AccountType)
                                </th>
                                <td style="font-size:small">
                                    @Html.DisplayFor(model => model.AccountType)
                                </td>
                            </tr>
                            <tr>
                                <th style="font-size:small">
                                    @Html.DisplayNameFor(model => model.AccountNumber)
                                </th>
                                <td style="font-size:small">
                                    @Html.DisplayFor(model => model.AccountNumber)
                                </td>
                            </tr>
                            <tr>
                                <th style="font-size:small">
                                    @Html.DisplayNameFor(model => model.Branch)
                                </th>
                                <td style="font-size:small">
                                    @Html.DisplayFor(model => model.Branch)
                                </td>
                            </tr>
                            <tr>
                                <th style="font-size:small">
                                    @Html.DisplayNameFor(model => model.email)
                                </th>
                                <td style="font-size:small">
                                    @Html.DisplayFor(model => model.email)
                                </td>
                            </tr>
                        </table>
                            <br />
                            <br />
                            <br />
                            <div class="form-group">
                                <div class="col-md-2" style="display:inline-block">
                                    <input type="submit" value="Refresh" onclick="location.href='@Url.Action("executeupdate", "CustomerRefresh",new { email = Model.email ,address = Model.address, customerphonenumber = Model.CustomerPhone})'" class="btn btn-block btn-flat" style="display:inline-block" />
                                    <input type="button" value="Cancel" onclick="location.href='@Url.Action("CustomerRefresh", "CustomerRefresh")'" class="btn btn-block btn-flat" style="background-color:red;display:inline-block;width:100%" />
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>



@if (ViewBag.SuccessMessage != null)
{
    <script>
        window.setTimeout(function () {
            $(".alert").fadeTo(500, 0).slideUp(500, function () {
                $(this).remove();
            });
        }, 4000);
    </script>
}

