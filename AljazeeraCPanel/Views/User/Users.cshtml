﻿@model IEnumerable<AljazeeraCPanel.Models.userlist>

@{
    ViewBag.Title = "Users";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<header>
    @*<script src="~/Content/jquery-1.11.3.min.js"></script>*@
    <script src="~/Content/jquery.dataTables.js"></script>
    <link href="~/Content/jquery.dataTables.css" rel="stylesheet" />

    <script>
        $(document).ready(function () {
            var table = $('#example').DataTable();
        });
    </script>
</header>

<section class="content">
    <div class="row">
        <div class="col-md-12">
            <div class="box box-info">
                <h2>Users Management</h2><br />
                <ol class="breadcrumb" style="font-size:medium">
                    Users Information
                </ol>
                @if (ViewBag.SuccessMessage != null)
                {
                    <div class="alert alert-success" role="alert">
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <strong>Success!</strong> @ViewBag.SuccessMessage
                    </div>
                }
                @if (ViewBag.failMessage != null)
                {
                    <div class="alert alert-danger" role="alert">
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <strong>Fail!</strong> @ViewBag.failMessage
                    </div>
                }


                @if (TempData["success"] != null)
                {
                    <div class="alert alert-success" role="alert">
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <strong>Success!</strong><br />
                        @TempData["success"].ToString()
                    </div>
                }

                <!-- /.box-header -->
                <div class="box-body">
                    <div class="col-lg-12 col-md-12 col-sm-12">
                        <table id="example" class="display nowrap" style="font-size:small">
                            <thead>
                                <tr>
                                    <th style="font-size:small">
                                        @Html.DisplayNameFor(model => model.user_id)
                                    </th>
                                    <th style="font-size:small">
                                        @Html.DisplayNameFor(model => model.name)
                                    </th>

                                    <th style="font-size:small">
                                        @Html.DisplayNameFor(model => model.rolename)
                                    </th>
                                    <th style="font-size:small">
                                        @Html.DisplayNameFor(model => model.user_branch)
                                    </th>

                                    <th style="font-size:small">
                                        @Html.DisplayNameFor(model => model.user_status)
                                    </th>
                                    <th style="font-size:small">
                                        Actions
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.OrderBy(item => item.user_id))
                                {
                                    <tr>
                                        <td style="font-size:small">
                                            @Html.DisplayFor(modelItem => item.user_id)
                                        </td>
                                        <td style="font-size:small">
                                            @Html.DisplayFor(modelItem => item.name)
                                        </td>
                                        <td style="font-size:small">
                                            @Html.DisplayFor(modelItem => item.rolename)
                                        </td>
                                        <td style="font-size:small">
                                            @Html.DisplayFor(modelItem => item.user_branch)
                                        </td>
                                        <td style="font-size:small">
                                            @Html.DisplayFor(modelItem => item.user_status)
                                        </td>

                                        <td style="font-size:small">
                                            @* WAPT05: state-changing actions are POST forms with an anti-forgery token.
                                               WAPT06: only the user id is sent; status is validated server-side. Edit stays a GET (it only opens the form). *@
                                            @Html.ActionLink("Edit", "Edit", new { id = item.user_id }, new { @style = "color:black;" }) |
                                            @using (Html.BeginForm("Reset", "User", FormMethod.Post, new { style = "display:inline" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.user_id" />
                                                <button type="submit" style="background:none;border:none;padding:0;color:black;cursor:pointer;text-decoration:underline">Reset</button>
                                            } |
                                            @using (Html.BeginForm("Deactivate", "User", FormMethod.Post, new { style = "display:inline" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.user_id" />
                                                <button type="submit" style="background:none;border:none;padding:0;color:black;cursor:pointer;text-decoration:underline">Deactivate</button>
                                            } |
                                            @using (Html.BeginForm("Activate", "User", FormMethod.Post, new { style = "display:inline" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.user_id" />
                                                <button type="submit" style="background:none;border:none;padding:0;color:black;cursor:pointer;text-decoration:underline">Activate</button>
                                            } |
                                            @using (Html.BeginForm("Delete", "User", FormMethod.Post, new { style = "display:inline", onsubmit = "return confirm('Submit a delete request for this user?');" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.user_id" />
                                                <button type="submit" style="background:none;border:none;padding:0;color:black;cursor:pointer;text-decoration:underline">Delete</button>
                                            }
                                        </td>
                                    </tr>
                                }


                            </tbody>
                        </table>

                    </div>
                    <br />
                    <div class="box-footer">
                        <section class="row">
                            <div class="col-md-6" style="display:inline-block">

                                @using (Html.BeginForm("Add", "User", FormMethod.Get, new { id = "form" }))
                                {
                                    <div class="form-group">
                                        <div class="col-xs-57 col-xs-offset-7">
                                            <input type="submit" onclick="submitanddisable()" value="Create new user" class="btn btn-lg btn-block btn-flat" style="color:white;font-size:small" />
                                        </div>
                                    </div>
                                }
                                @using (Html.BeginForm("CreatePdf", "User", new { id = "form" }))
                                {
                                    <div class="form-group">
                                        <div class="col-xs-57 col-xs-offset-8">
                                            <input type="submit" onclick="submitanddisable()" value="Print" class="btn btn-lg btn-block btn-flat" style="color:white;font-size:small" />
                                        </div>
                                    </div>
                                }
                            </div>
                        </section>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@if (ViewBag.SuccessMessage != null)
{
    <script>
        window.setTimeout(function () {
            $(".alert").fadeTo(500, 0).slideUp(500, function () {
                $(this).remove();
            });
        }, 4000);
    </script>
}
@if (ViewBag.failMessage != null)
{
    <script>
        window.setTimeout(function () {
            $(".alert").fadeTo(500, 0).slideUp(500, function () {
                $(this).remove();
            });
        }, 4000);
    </script>
}

