@model IEnumerable<FCBCPanel.Models.BranchModel>


<header>

    @*<script src="~/Content/jquery-1.11.3.min.js"></script>*@
    <script src="~/Content/jquery.dataTables.js"></script>
    <link href="~/Content/jquery.dataTables.css" rel="stylesheet" />

    <script>
        $(document).ready(function () {
            var table = $('#example').DataTable();
        });
    </script>
</header>

<section class="content">
    <div class="row">
        <div class="col-md-12">
            <!-- TABLE: USerLog -->
            <div class="box box-info">
                <h2>Users Log</h2><br />
                <ol class="breadcrumb" style="font-size:medium">
                    Users Log Report
                </ol>
                <div class="box-body">
                    @if (TempData["success"] != null)
                    {
                        <div class="alert alert-success" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                            <strong>Success!</strong><br />
                            @TempData["success"].ToString()
                        </div>
                    }
                    <div class="col-lg-12 col-md-11 col-sm-11">
                        <table id="example" class="display nowrap" style="font-size:small">
                            <thead>
                                <tr>
                                    <th style="font-size:small">
                                        @Html.DisplayNameFor(model => model.branch_code)
                                    </th>
                                    <th style="font-size:small">
                                        @Html.DisplayNameFor(model => model.branch_name)
                                    </th>
                                    <th style="font-size:small">
                                        @Html.DisplayNameFor(model => model.branch_name_arabic)
                                    </th>
                                    <th style="font-size:small">
                                        @Html.DisplayNameFor(model => model.branch_status)
                                    </th>
                                    <th style="font-size:small">
                                        Actions
                                    </th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td style="font-size:small">
                                            @Html.DisplayFor(modelItem => item.branch_code)
                                        </td>
                                        <td style="font-size:small">
                                            @Html.DisplayFor(modelItem => item.branch_name)
                                        </td>
                                        <td style="font-size:small">
                                            @Html.DisplayFor(modelItem => item.branch_name_arabic)
                                        </td>
                                        <td style="font-size:small">
                                            @Html.DisplayFor(modelItem => item.branch_status)
                                        </td>
                                        <td style="font-size:small">
                                            @Html.ActionLink("Edit", "Edit", new { id = item.branch_code }, new { @style = "color:black;" }) |
                                            @Html.ActionLink("Delete", "Delete", new { id = item.branch_code }, new { @style = "color:black;" })
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="col-md-8">
                        @using (Html.BeginForm("Add", "Branchs", FormMethod.Get, new { id = "form" }))
                        {
                            <div class="form-group">
                                <div class="col-xs-57 col-xs-offset-8">
                                    <input type="submit" onclick="submitanddisable()" value="Add Branch" class="btn btn-md" style="color:white;font-size:small" />
                                </div>
                            </div>
                        }
                    </div>
                    <br />
                    <br />
                </div>
            </div>
        </div>
    </div>
</section>

@if (TempData["Success"] != null)
{
    <script>
        Swal.fire({
            icon: 'success',
            title: 'Successful',
            text: '@TempData["Success"].ToString()'
        })
    </script>
}