@model FCBCPanel.Models.AccountTypeModel


<style>
    dd {
        padding-left: 5%;
    }
    dt{
        width:auto;
    }
</style>

<section class="content">
    <div class="row">
        <div class="col-md-12">
            <div class="box box-solid">
                <div class="box-header with-border">
                    @*<i class="fa fa-text-width"></i>*@
                    <h3 class="box-title">Account Type Authorization</h3>
                </div>
            </div>
            <br />
            <ol class="breadcrumb" style="font-size:medium">
                Account Type Checker
            </ol>
            <div class="box-body">
                <div class="row">
                    <div class="col-md-10 col-md-offset-3">
                        <blockquote>
                            <dl class="dl-horizontal col-md-12">
                                <dt style=" text-align: left;width:auto">
                                    @Html.DisplayNameFor(model => model.account_type_code)
                                </dt>
                                <dd style=" text-align: left;">
                                    @Html.DisplayFor(model => model.account_type_code)
                                </dd>
                                <dt style="width:auto">
                                    @Html.DisplayNameFor(model => model.account_type)
                                </dt>
                                <dd>
                                    @Html.DisplayFor(model => model.account_type)
                                </dd>
                                <dt style=" text-align: left;width:auto">
                                    @Html.DisplayNameFor(model => model.account_type_arabic)
                                </dt>
                                <dd>
                                    @Html.DisplayFor(model => model.account_type_arabic)
                                </dd>
                                <dt style=" text-align :left;width:auto">
                                    @Html.DisplayNameFor(model => model.account_type_no)
                                </dt>
                                <dd>
                                    @Html.DisplayFor(model => model.account_type_no)
                                </dd>
                            </dl>
                        </blockquote>
                    </div>
                </div>
                <div class="btn-toolbar justify-content-between" role="toolbar" aria-label="Toolbar with button groups" style="position:relative;left:30%">
                    <div class="btn-group" role="group" aria-label="First group">
                        @Html.ActionLink("Authorize account type", "AuthorizeAccountType", new { account_type_code = Model.account_type_code }, new { @class = "btn btn-success btn-block btn-flat " })
                    </div>
                    <div class="btn-group" role="group" aria-label="Second group">
                        @Html.ActionLink("Reject account type", "RejectAccountType", new { account_type_code = Model.account_type_code }, new { @class = "btn btn-danger  btn-block btn-flat " })
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    $("#resoan").hide();
    $("input[name='status']").on("change", function () {
        if ($(this).val() == "false") {
            $("#resoan").show();
        }
    });
</script>