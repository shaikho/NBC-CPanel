@model IEnumerable<FCBCPanel.Models.AccountTypeModel>


<header>
    @*<script src="~/Content/jquery-1.11.3.min.js"></script>*@
    <script src="~/Content/jquery.dataTables.js"></script>
    <link href="~/Content/jquery.dataTables.css" rel="stylesheet" />
    <script>
        $(document).ready(function () {
            var table = $('#example').DataTable();
        });
    </script>
</header>

<section class="content">
    <div class="row">
        <div class="col-md-12">
            <!-- TABLE: USerLog -->
            <div class="box box-info">
                <h2>Users Log</h2><br />
                <ol class="breadcrumb" style="font-size:medium">
                    Users Log Report
                </ol>
                <div class="box-body">
                    @if (TempData["success"] != null)
                    {
                        <div class="alert alert-success" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                            <strong>Success!</strong><br />
                            @TempData["success"].ToString()
                        </div>
                    }
                    <div class="col-lg-12 col-md-11 col-sm-11">
                        <table id="example" class="display nowrap" style="font-size:small">
                            <thead>
                                <tr>
                                    <th style="font-size:small">
                                        @Html.DisplayNameFor(model => model.account_type_code)
                                    </th>
                                    <th style="font-size:small">
                                        @Html.DisplayNameFor(model => model.account_type)
                                    </th>
                                    <th style="font-size:small">
                                        @Html.DisplayNameFor(model => model.account_type_arabic)
                                    </th>
                                    <th style="font-size:small">
                                        @Html.DisplayNameFor(model => model.account_type_no)
                                    </th>
                                    <th style="font-size:small">
                                        Actions
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td style="font-size:small">
                                            @Html.DisplayFor(modelItem => item.account_type_code)
                                        </td>
                                        <td style="font-size:small">
                                            @Html.DisplayFor(modelItem => item.account_type)
                                        </td>
                                        <td style="font-size:small">
                                            @Html.DisplayFor(modelItem => item.account_type_arabic)
                                        </td>
                                        <td style="font-size:small">
                                            @Html.DisplayFor(modelItem => item.account_type_no)
                                        </td>
                                        <td style="font-size:small">
                                            @Html.ActionLink("Details", "Details", new { id = item.account_type_code }, new { @style = "color:black;" })
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <br />
                    <br />
                </div>
            </div>
        </div>
    </div>
</section>

@if (TempData["success"] != null)
{
    <script>
        Swal.fire({
            icon: 'success',
            title: 'Successful',
            text: '@TempData["success"].ToString()'
        })
    </script>
}

@if (TempData["fail"] != null)
{
    <script>
        Swal.fire({
            icon: 'error',
            title: 'Failed',
            text: '@TempData["fail"].ToString()'
        })
    </script>
}

@if (TempData["rejectsuccess"] != null)
{
    <script>
        Swal.fire({
            icon: 'warning',
            title: 'Successful',
            text: '@TempData["rejectsuccess"].ToString()'
        })
    </script>
}

@if (TempData["rejectfail"] != null)
{
    <script>
        Swal.fire({
            icon: 'error',
            title: 'Failed',
            text: '@TempData["rejectfail"].ToString()'
        })
    </script>
}