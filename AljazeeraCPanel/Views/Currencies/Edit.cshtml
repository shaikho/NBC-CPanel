@model FCBCPanel.Models.CurrencyModel


<section class="content">
    <div class="row">
        <!-- Left col -->
        <section class="col-md-12 connectedSortable">
            <!-- Own Transfer -->
            <div class="box box-info">
                <h2>Personal Information</h2><br />
                <ol class="breadcrumb" style="font-size:medium">
                    User Information
                </ol>
                <div class="box-body">
                    <div class="row">
                        <div class="col-md-8 col-md-offset-2">
                            @using (Html.BeginForm())
                            {
                                @Html.AntiForgeryToken()
                                <div class="form-horizontal">
                                    @Html.ValidationSummary(true)
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.currency_name, new { @class = "control-label col-md-2" })
                                        <div class="col-md-10">
                                            @Html.TextBoxFor(model => model.currency_name, new { @class = "form-control ", @placeholder = "Arabic tip title" })
                                            @Html.ValidationMessageFor(model => model.currency_name)
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.currency_summary, new { @class = "control-label col-md-2" })
                                        <div class="col-md-10">
                                            @Html.TextAreaFor(model => model.currency_summary, new { @class = "form-control ", @placeholder = "Arabic content" })
                                            @Html.ValidationMessageFor(model => model.currency_summary)
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.currency_status, new { @class = "control-label col-md-2" })
                                        <div class="col-md-10">
                                            @Html.DropDownListFor(model => model.currency_status, new List<SelectListItem>
                                            {
                                                new SelectListItem {Text = "Active", Value = "1"},
                                                new SelectListItem {Text = "Deactive", Value = "0"}
                                            }, new { @class = "form-control", @style = "width: 100%" })
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <div class="col-xs-57 col-xs-offset-6">
                                        <input type="submit" onclick="submitanddisable()" value="Update" class="btn btn-md" style="color:white;font-size:small" />
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</section>