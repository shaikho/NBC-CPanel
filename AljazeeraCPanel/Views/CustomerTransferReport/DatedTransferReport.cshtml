@model AljazeeraCPanel.Models.CustomerTransferReportViewModel


<section class="content">
    <div class="row">
        <!-- Left col -->
        <section class="col-md-12 connectedSortable">
            <!-- Own Transfer -->
            <div class="box box-info">
                <h2>Transfers Report</h2><br />
                <ol class="breadcrumb" style="font-size:medium">
                    Customer Transfer Report
                </ol>
                <div class="box-body">
                    <div class="row">
                        <div class="col-md-10">

                            @using (Html.BeginForm(new { id = "form" }))
                            {
                                @Html.AntiForgeryToken()
                            <div class="form-horizontal">
                                @Html.ValidationSummary(true)

                                @*<input data-provide="datepicker">*@

                                <div class="form-group">
                                    @Html.LabelFor(model => model.FromDate, new { @class = "control-label col-md-4" })
                                    <div class="col-md-8">
                                        @Html.TextBoxFor(model => model.FromDate, new { @class = "form-control datepicker", @placeholder = "From Date"})
                                    </div>
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.ToDate, new { @class = "control-label col-md-4" })
                                    <div class="col-md-8">
                                        @Html.TextBoxFor(model => model.ToDate, new { @class = "form-control datepicker", @placeholder = "To Date" })
                                        @Html.ValidationMessageFor(model => model.AccountNumber)
                                    </div>
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.AccountNumber, new { @class = "control-label col-md-4" })
                                    <div class="col-md-8">
                                        @Html.TextBoxFor(model => model.AccountNumber, new { @class = "form-control ", @placeholder = "Account #...", @maxlength = "11", @id = "accountnumber", @type = "number" })
                                        @Html.ValidationMessageFor(model => model.AccountNumber)
                                    </div>
                                </div>

                                <div class="form-group">
                                    <div class="col-xs-57 col-xs-offset-6">
                                        <input type="submit" onclick="submitanddisable()" formaction="@Url.Action("TransferReport","CustomerTransferReport")" value="Show report" class="btn btn-lg btn-flat btn-block" style="color:white;font-size:small" />
                                    </div>
                                </div>
                            </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</section>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}


