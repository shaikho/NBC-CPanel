@model AljazeeraCPanel.Models.Transferlimit

<section class="content">
    <div class="row">
        <div class="col-md-auto col-md-12">
            <!-- TABLE: LATEST Transactions -->
            <div class="box box-info">
                <h2>Customers transfer limits</h2><br />
                <ol class="breadcrumb" style="font-size:medium">
                    profile details
                </ol>
                @using (Html.BeginForm(new { id = "form" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-horizontal">
                        @Html.ValidationSummary(true)

                        <div class="form-group">
                            @Html.LabelFor(model => model.tran_id, new { @class = "control-label col-md-4" })
                            <div class="col-md-5">
                                @Html.TextBoxFor(model => model.tran_id, new { @class = "form-control ", @readonly = "true", @placeholder = "Service Name" })
                                @Html.ValidationMessageFor(model => model.tran_id)
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.servicename, new { @class = "control-label col-md-4" })
                            <div class="col-md-5">
                                @Html.TextBoxFor(model => model.servicename, new { @class = "form-control ", @placeholder = "Service Name" })
                                @Html.ValidationMessageFor(model => model.servicename)
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.amount_limit, new { @class = "control-label col-md-4" })
                            <div class="col-md-5">
                                @Html.TextBoxFor(model => model.amount_limit, new { @class = "form-control ", @placeholder = "Service Name", @type = "number" })
                                @Html.ValidationMessageFor(model => model.amount_limit)
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.daily_limit, new { @class = "control-label col-md-4" })
                            <div class="col-md-5">
                                @Html.TextBoxFor(model => model.daily_limit, new { @class = "form-control ", @placeholder = "Service Name", @type = "number" })
                                @Html.ValidationMessageFor(model => model.daily_limit)
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.number_limit, new { @class = "control-label col-md-4" })
                            <div class="col-md-5">
                                @Html.TextBoxFor(model => model.number_limit, new { @class = "form-control ", @placeholder = "Service Name", @type = "number" })
                                @Html.ValidationMessageFor(model => model.number_limit)
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-md-5 col-xs-offset-5">
                            <input type="submit" value="update" formaction="@Url.Action("edit","Profile")" class="btn btn-lg btn-flat btn-block" onclick="submitanddisable()" style="color:white;font-size:small" />
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>