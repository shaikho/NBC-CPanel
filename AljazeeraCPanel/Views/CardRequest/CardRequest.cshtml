@model IEnumerable<AljazeeraCPanel.Models.ChqRequest>

@{
    ViewBag.Title = "View";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<header>

    @*<script src="~/Content/jquery-1.11.3.min.js"></script>*@
    <script src="~/Content/jquery.dataTables.js"></script>
    <link href="~/Content/jquery.dataTables.css" rel="stylesheet" />

    <script>
        $(document).ready(function () {
            var table = $('#example').DataTable();
        });
    </script>
</header>

<section class="content">
    <div class="row">
        <div class="col-md-12">
            <!-- TABLE: LATEST Transactions -->
            <div class="box box-info">
                <h2>Atm Card Requests Information</h2><br />
                <ol class="breadcrumb" style="font-size:medium">
                    Cards  requests
                </ol>
                @if (ViewBag.SuccessMessage != null)
                {
                    <div class="alert alert-success" role="alert">
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        @ViewBag.SuccessMessage
                    </div>
                }
                <!-- /.box-header -->
                <div class="box-body">
                    <div class="col-lg-12 col-md-11 col-sm-11">
                        <table id="example" class="display nowrap" style="font-size:small">
                            <thead>
                                <tr>
                                    <th style="font-size:small">
                                        @Html.DisplayNameFor(model => model.request_id)
                                    </th>
                                    <th style="font-size:small">
                                        @Html.DisplayNameFor(model => model.reqdate)
                                    </th>

                                    <th style="font-size:small">
                                        @Html.DisplayNameFor(model => model.userid)
                                    </th>
                                    <th style="font-size:small">
                                        @Html.DisplayNameFor(model => model.act)
                                    </th>
                                    <th style="font-size:small">
                                        @Html.DisplayNameFor(model => model.branchname)
                                    </th>
                                    <th style="font-size:small">
                                        @Html.DisplayNameFor(model => model.booksize)
                                    </th>
                                    <th style="font-size:small">
                                        @Html.DisplayNameFor(model => model.reqsts)
                                    </th>
                                    <th style="font-size:small">
                                        Actions
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td style="font-size:small">
                                            @Html.DisplayFor(modelItem => item.request_id)
                                        </td>
                                        <td style="font-size:small">
                                            @Html.DisplayFor(modelItem => item.reqdate)
                                        </td>
                                        <td style="font-size:small">
                                            @Html.DisplayFor(modelItem => item.userid)
                                        </td>
                                        <td style="font-size:small">
                                            @Html.DisplayFor(modelItem => item.act)
                                        </td>
                                        <td style="font-size:small">
                                            @Html.DisplayFor(modelItem => item.branchname)
                                        </td>
                                        <td style="font-size:small">
                                            @Html.DisplayFor(modelItem => item.booksize)
                                        </td>
                                        <td style="font-size:small">
                                            @Html.DisplayFor(modelItem => item.reqsts)
                                        </td>
                                        <td style="font-size:small">
                                            @Html.ActionLink("Accept", "Accept", new { id = item.request_id }, new { @style = "color:black;" }) |
                                            @Html.ActionLink("Reject", "Reject", new { id = item.request_id }, new { @style = "color:black;" })
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <br />
            <br />
            @using (Html.BeginForm("CreatePdf", "CardRequest", new { id = "form" }))
            {
                <div class="form-group">
                    <div class="col-md-4 col-xs-offset-2">
                        <input type="submit" onclick="submitanddisable()" value="Print" class="btn btn-lg btn-block btn-flat" style="color: white; font-size: small" />
                    </div>
                </div>
            }
</section>

@*@if (ViewBag.SuccessMessage != null)
{
    <script type="text/javascript">
                    window.onload = function () {
                        alert("@ViewBag.SuccessMessage");
                    };*@
    </script>
}
@if (ViewBag.SuccessMessage != null)
{
    <script>
        window.setTimeout(function () {
            $(".alert").fadeTo(500, 0).slideUp(500, function () {
                $(this).remove();
            });
        }, 4000);
    </script>
}