</section>

<script>
    var alert = $('.alert');
    $('.button').click(function () {
        alert.addClass('open');
    });
    $('span.close').on('click', function () {
        alert.removeClass('open');
    });
</script>

@if (ViewBag.SuccessMessage != null)
{
    <script type="text/javascript">
        window.onload = function () {
            alert("@ViewBag.SuccessMessage");
        };
    </script>
}