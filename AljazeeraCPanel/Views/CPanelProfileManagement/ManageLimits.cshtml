            <div class="box box-info">
                <h2>   Customers Profile Informations</h2><br />
                <ol class="breadcrumb" style="font-size:medium">
                    Manage Limit For Bank Services
                </ol>


                <div class="box-body col-md-10 col-md-offset-1">
                    <div class="row">
                        <div class="col-md-10">

                            @using (Html.BeginForm(new { id = "form" }))
                            {
                                @Html.AntiForgeryToken()

                                <div class="form-horizontal">
                                    @Html.ValidationSummary(true)

                                    <div class="form-group">
                                        @Html.LabelFor(model => model.service_name, new { @class = "control-label col-md-5" })
                                        <div class="col-md-6">
                                            @Html.TextBoxFor(model => model.service_name, new { @class = "form-control ", @placeholder = "# Service Name", @value = Model.service_name, @readonly = true })
                                            @Html.ValidationMessageFor(model => model.service_name)
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        @Html.LabelFor(model => model.Transaction_per_day, new { @class = "control-label col-md-5" })
                                        <div class="col-md-6">
                                            @Html.TextBoxFor(model => model.Transaction_per_day, new { @class = "form-control ", @placeholder = "# Max number of transactions", @type = "number", @value = Model.Transaction_per_day })
                                            @Html.ValidationMessageFor(model => model.Transaction_per_day)
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        @Html.LabelFor(model => model.Transaction_amount, new { @class = "control-label col-md-5" })
                                        <div class="col-md-6">
                                            @Html.TextBoxFor(model => model.Transaction_amount, new { @class = "form-control ", @placeholder = "# Maximum transfer limit", @type = "number", @value = Model.Transaction_amount })
                                            @Html.ValidationMessageFor(model => model.Transaction_amount)
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        @Html.LabelFor(model => model.Transactions_accumulation, new { @class = "control-label col-md-5" })
                                        <div class="col-md-6">
                                            @Html.TextBoxFor(model => model.Transactions_accumulation, new { @class = "form-control ", @placeholder = "# Daily accumulative transfer limit", @type = "number", Model.Transactions_accumulation })
                                            @Html.ValidationMessageFor(model => model.Transactions_accumulation)
                                        </div>
                                    </div>

                                    @*<div class="form-group">
                                            @Html.LabelFor(model => model.Fees, new { @class = "control-label col-md-5" })
                                            <div class="col-md-4">
