@using AljazeeraCPanel.Models;
@using FCBCPanel.Models;
@model IEnumerable<AljazeeraCPanel.Models.TransactionsDetailsModel>

@{
    ViewBag.Title = "Home Page";
    List<Charter> usersperbranchscount = Session["usersperbranchscount"] as List<Charter>;
    List<Charter> usersstatuses = Session["usersstatuses"] as List<Charter>;
    List<Charter> branchstransactionscount = Session["branchstransactionscount"] as List<Charter>;
    string sdecbalance = Session["SDECBalance"] as string;
    DashboardData dashboard = Session["dashboarddata"] as DashboardData;
    Boolean isazalive = (Boolean)Session["isazalive"];
    Boolean isebsalive = (Boolean)Session["isebsalive"];
    Layout = null;

}

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>@ViewBag.Title - NBE CPanel</title>
    <style>
        @@font-face {
            font-family: 'Almarai-Regular';
            src: url('../../fonts/Almarai-Regular.ttf') format('truetype');
        }


        * {
            font-family: 'Almarai-Regular', sans-serif;
        }

        /* NBE brand: green sidebar (was navy #0A0A29), maze texture kept */
        #sidebar {
            background-color: #1A7A3C;
            background-image: url('../../Images/jsb_images/maze-white.png') !important;
        }

        #englishnavbar ul li a:hover {
            background-color: #F5871F;
        }

        .navready {
            height: 100vh !important;
        }
    </style>



    <!-- Bootstrap CSS CDN -->
    <link href="~/Content/bootstrap(downloaded).min.css" rel="stylesheet" />
    <!-- Our Custom CSS -->
    @*<link rel="stylesheet" type="text/css" href="css/bootstrap.min.css">*@
    <!-- Optional Bootstrap theme -->
    <link rel="stylesheet" href="~/Content/bootstrap-theme.min.css">
    <!-- Date Picker -->
    <link href="~/Content/bootstrap-datepicker.css" rel="stylesheet" />
    <link href="~/Content/mdb.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/Content/style.css">
    <!-- NBE (Khartoum) brand theme — load last so it overrides -->
    <link rel="stylesheet" href="~/Content/nbe-theme.css">
    <link href="~/Images/jsb_images/logo_transperant" rel="shortcut icon" type="image/x-icon" />
    <script src="~/Scripts/jquery-3.4.1.js"></script>
    <script src="~/Scripts/chart.js"></script>

</head>

<body>
    <div class="wrapper">
        <div class="navready">
            <nav id="sidebar" style="width: 30%; min-height: 100%; font-size: 12px; background-color: #1A7A3C">
                <div class="sidebar-header" style="background-color: #ffffff; background-image: url('../../Images/jsb_images/maze-white.png');">
                    <a href="@Url.Action("Index", "Home")"><img src="~/Images/jsb_images/Capture-removebg-preview.png" style="width:90%;height:20%;position: relative;margin-left:5%" /></a>
                </div>
                @Html.Action("TopMenu", "Home")
            </nav>
        </div>
        <div class="container body-content" style="width:100%;height:100%;overflow-x:hidden;overflow-y:hidden">
            <h4 style="position:absolute;left:80%;top:4%"> You're logged in as @ViewData["adminname"].ToString()</h4>
            <h2>Home</h2>
            <br />
            @if (ViewBag.SuccessMessage != null)
            {
                <div class="alert alert-success" role="alert">
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <strong>Success!</strong> @ViewBag.SuccessMessage
                </div>
            }
            <ol class="breadcrumb" style="font-size:medium">
                IBanking Analysis
            </ol>
            <div class="row py-2">
                <div class="col-md-3">
                    <div class="panel panel-info">
                        <div class="panel-heading">
                            <h3 class="panel-title">Account customers</h3>
                        </div>
                        <div class="panel-body">
                            @dashboard.CardCustomersCount
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="panel panel-info">
                        <div class="panel-heading">
                            <h3 class="panel-title">Card customers</h3>
                        </div>
                        <div class="panel-body">
                            @dashboard.AccountCustomersCount
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="panel panel-info">
                        <div class="panel-heading">
                            <h3 class="panel-title">Linked accounts</h3>
                        </div>
                        <div class="panel-body">
                            @dashboard.LinkedAccountCount
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="panel panel-info">
                        <div class="panel-heading">
                            <h3 class="panel-title">Total customers</h3>
                        </div>
                        <div class="panel-body">
                            @dashboard.TotalCustomersCount
                        </div>
                    </div>
                </div>
            </div>
            <ol class="breadcrumb" style="font-size:medium">
                Omni connectivity
            </ol>
            <div class="row py-2">
                <div class="col-md-6">
                    @if (!isazalive)
                    {


                        <div class="panel panel-success">
                            <div class="panel-heading">
                                <h3 class="panel-title">AZ Connectivity</h3>
                            </div>
                            <div class="panel-body">
                                Connected
                            </div>
                        </div> }
                    else
                    {
                        <div class="panel panel-danger">
                            <div class="panel-heading">
                                <h3 class="panel-title">AZ Connectivity</h3>
                            </div>
                            <div class="panel-body">
                                Offline
                            </div>
                        </div>}
                </div>
                <div class="col-md-6">
                    @if (!isebsalive)
                    {


                        <div class="panel panel-success">
                            <div class="panel-heading">
                                <h3 class="panel-title">EBS Connectivity</h3>
                            </div>
                            <div class="panel-body">
                                Connected
                            </div>
                        </div> }
                    else
                    {
                        <div class="panel panel-danger">
                            <div class="panel-heading">
                                <h3 class="panel-title">EBS Connectivity</h3>
                            </div>
                            <div class="panel-body">
                                Offline
                            </div>
                        </div>}
                </div>
                <div class="col-md-6">
                    @if (!isebsalive)
                    {


                        <div class="panel panel-success">
                            <div class="panel-heading">
                                <h3 class="panel-title">Core Bank Connectivity</h3>
                            </div>
                            <div class="panel-body">
                                Connected
                            </div>
                        </div> }
                    else
                    {
                        @*<div class="panel panel-danger">*@
                        <div class="panel panel-success">
                            <div class="panel-heading">
                                <h3 class="panel-title">Core Bank Connectivity</h3>
                            </div>
                            <div class="panel-body">
                                Connected
                            </div>
                        </div>}
                </div>
            </div>

        </div>

    </div>
</body>

<script type="text/javascript">
    $(document).ready(function () {
        $('#sidebarCollapse').on('click', function () {
            $('#sidebar').toggleClass('active');
        });
    });
</script>

<script>

    var data1 = [];
    var labels1 = [];
    for (var i = 0; i < counter1; i++) {
        labels1.push(usersstatuses[i].status);
    }
    for (var i = 0; i < counter1; i++) {
        data1.push(usersstatuses[i].count);
    }
    var ctx = document.getElementById('polarchart').getContext('2d');
    new Chart(ctx, {
        data: {
            datasets: [{
                data: data1,
                backgroundColor: [
                    'rgba(255, 99, 132, 0.2)',
                    'rgba(54, 162, 235, 0.2)',
                    'rgba(255, 206, 86, 0.2)',
                    'rgba(255, 206, 86, 0.2)',
                    'rgba(75, 192, 192, 0.2)',
                    'rgba(153, 102, 255, 0.2)'
                ],
                borderColor: [
                    'rgba(255, 99, 132, 1)',
                    'rgba(54, 162, 235, 1)',
                    'rgba(255, 206, 86, 1)',
                    'rgba(255, 206, 86, 0.2)',
                    'rgba(75, 192, 192, 0.2)',
                    'rgba(153, 102, 255, 0.4)'
                ]
            }],
            labels: labels1
        },
        type: 'pie'
    });

</script>

