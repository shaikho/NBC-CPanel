@model IEnumerable<AljazeeraCPanel.Models.Menu>

<style>
    /* NBE brand: green menu items with the maze texture (page-relative path),
       orange on hover. Mirrors the original navy+maze design, recoloured to green. */
    #englishnavbar ul li a {
        background-color: #1A7A3C;
        background-image: url('../../Images/jsb_images/maze-white.png');
        color: #ffffff;
    }

        #englishnavbar ul li a:hover {
            background-color: #F5871F;
            background-image: url('../../Images/jsb_images/maze-white.png');
            color: #ffffff;
        }

        /* Restore the expand/collapse caret anchor: style.css draws the arrow via
           a[aria-expanded]::before, but it was positioned by a[data-toggle="collapse"]
           which we removed — so re-add position:relative on our toggle links. */
        #englishnavbar a.js-submenu-toggle {
            position: relative;
        }
</style>

<div id="englishnavbar">
    <ul class="list-unstyled " style="color:#FAFAFA">
        @foreach (var m in Model)
        {
            if (m.MenuParentID == 0)
            {
                var submenu = Model.Where(n => n.MenuParentID == m.MID).ToList();
                if (submenu != null && submenu.Count > 0)
                {
                    <li style="color:#FAFAFA">
                        <a href="#@m.MID" class="js-submenu-toggle" aria-expanded="false">
                            @m.MenuName
                        </a>
                        <ul class="collapse list-unstyled" id="@m.MID">
                            @foreach (var e in submenu)
                            {
                                var submenu2 = Model.Where(n => n.subMenuParentID == e.MID).ToList();
                                if (submenu2 != null && submenu2.Count > 0)
                                {
                                    <li>
                                        <a href="#@e.MID" class="js-submenu-toggle" aria-expanded="false">
                                            @e.MenuName
                                        </a>
                                        <ul id="@e.MID" class="collapse list-unstyled">
                                            @foreach (var ee in submenu2)
                                            {
                                                string exampleString = ee.MenuURL;
                                                // Split string on spaces. This will separate all the words in a string
                                                string[] words = exampleString.Split('/');
                                                <li style="color:#FAFAFA"><a href="@ee.MenuURL">@ee.MenuName </a></li>
                                            }
                                        </ul>
                                    </li>
                                }
                                else
                                {
                                    string exampleString = e.MenuURL;
                                    // Split string on spaces. This will separate all the words in a string
                                    string[] words = exampleString.Split('/');
                                    <li><a href="@Url.Action(words[1],words[0])" style="color:#FAFAFA">@e.MenuName </a></li>
                                }
                            }
                        </ul>
                    </li>
                }
                else
                {
                    //if parent menu does not have child menu
                    <li>
                        <a href="@m.MenuURL">@m.MenuName</a>
                    </li>
                }
            }
        }
        <li><a href="@Url.Action("Logout", "Home")" style="color:#FAFAFA"> Logout <img src="~/Images/Exit_64px(white).png" width="35" height="35" style="position:relative;left:69%" /></a></li>
    </ul>
</div>

@* Self-contained sidebar submenu toggle.
   The layout pages load jQuery twice and both Bootstrap and MDB (mdb.js) bind to
   data-toggle="collapse", which double-fired and left submenus stuck open. This
   handler owns the toggle instead, so behaviour is identical on every page. *@
<script type="text/javascript">
    (function ($) {
        if (!$) { return; }
        $(function () {
            $('#englishnavbar')
                .off('click.nbeSubmenu')
                .on('click.nbeSubmenu', 'a.js-submenu-toggle', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    var id = ($(this).attr('href') || '').replace('#', '');
                    var target = id ? document.getElementById(id) : null;
                    if (target) {
                        $(target).stop(true, true).slideToggle(150);
                        $(this).toggleClass('open').attr('aria-expanded',
                            $(this).hasClass('open') ? 'true' : 'false');
                    }
                });
        });
    })(window.jQuery);
</script>
